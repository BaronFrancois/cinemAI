# Copier ce fichier vers .env, puis remplacer uniquement les valeurs nécessaires.
# Ne jamais publier, envoyer ou committer le fichier .env réel.

# Clé créée dans Google AI Studio.
# Le SDK Google GenAI détecte automatiquement cette variable.
GEMINI_API_KEY=remplacer_par_votre_cle_google

# Modèle texte utilisé par le composeur.
GEMINI_MODEL=gemini-3.5-flash

# Utiliser mock pour les tests hors ligne, google pour Gemini réel.
CINEMAI_LLM_MODE=mock
CINEMAI_LLM_TIMEOUT_MS=30000

# Adresse du futur serveur local. La clé ne devra jamais atteindre index.html.
CINEMAI_SERVER_HOST=127.0.0.1
CINEMAI_SERVER_PORT=4175

# Modèles réservés aux lots image et vidéo futurs.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_OMNI_MODEL=gemini-omni-flash-preview
GEMINI_VEO_MODEL=veo-3.1-fast-generate-preview
